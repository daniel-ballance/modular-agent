{
  "name": "modular-agent-claude-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "A modular-agent-plugin/1 Provider that reaches Claude models through the Claude Agent SDK and the Claude Code login",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
