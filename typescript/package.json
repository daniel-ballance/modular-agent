{
  "name": "modular-agent",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "tsc -b && node --test --test-concurrency=4 packages/*/dist/test/*.test.js packages/claude/dist/src/test/*.test.js",
    "agent": "node packages/agent/dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.0"
  }
}
