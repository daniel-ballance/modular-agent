{
  "scenario": "waiting-approval-reopen-durable-effect",
  "about": "Reopen durable work after effect. Never restore delivery or spend the allow twice.",
  "rules": ["contracts.md#approvals-that-wait","bindings/data.md#waiting-approval-records","sdk/api.md#questions"],
  "agent": {"durability":"durable","plugins":["counter"],"approval":"all","maxApprovalWaitMs":100,"settings":{"approvalWait":"untilDeadline"}},
  "model": [
    {"toolCalls":[{"name":"bump","input":{"hold":true,"note":"kit-counter"}}]},
    {"text":"Done."}
  ],
  "steps": [
    {"prompt":"Bump the counter.","expect":{"outcome":"completed","openToolCalls":["$call"],"toolResults":[],"parked":{"timeLimitMs":100},"count":0}},
    {"poll":{"present":true},"expect":{"view":"exact"}},
    {"barrier":{"arm":"afterEffect"}},
    {"decide":"allow","expect":{"accepted":true}},
    {"barrier":{"reached":"afterEffect"}},
    {"stop":"kill","expect":{"count":1}},
    {"reopen":true},
    {"wait":true,"expect":{"settled":{"status":"outcomeUnknown","decision":"allow","actor":"user"},"count":1}}
  ]
}
