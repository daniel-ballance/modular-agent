{
  "scenario": "waiting-approval-changed-worker",
  "about": "Changing worker after an allow refuses the original call without a substitute request.",
  "rules": ["contracts.md#approvals-that-wait","bindings/data.md#waiting-approval-records","sdk/api.md#questions"],
  "requires": {"approvalsOutlastTurns":true,"severalActors":true},
  "agent": {"durability":"kept","plugins":["counter"],"approval":"all","maxApprovalWaitMs":100,"settings":{"approvalWait":"untilDeadline"},"actors":[{"id":"worker","kind":"user","rights":["watch","input","tools"]},{"id":"reviewer","kind":"user","rights":["watch","approve"]}],"severalActors":true},
  "model": [
    {"toolCalls":[{"name":"bump","input":{"hold":false,"note":"kit-counter"}}]},
    {"text":"Done."}
  ],
  "steps": [
    {"prompt":"Bump the counter.","as":"worker","expect":{"outcome":"completed","openToolCalls":["$call"],"toolResults":[],"parked":{"timeLimitMs":100},"count":0}},
    {"poll":{"present":true},"as":"reviewer","expect":{"view":"exact"}},
    {"barrier":{"arm":"beforeHandoff"}},
    {"decide":"allow","as":"reviewer","expect":{"accepted":true}},
    {"barrier":{"reached":"beforeHandoff"}},
    {"change":{"removeRight":{"actor":"worker","right":"tools"}}},
    {"barrier":{"release":"beforeHandoff"}},
    {"wait":true,"expect":{"settled":{"status":"refused","decision":"allow","actor":"reviewer"},"count":0}}
  ]
}
