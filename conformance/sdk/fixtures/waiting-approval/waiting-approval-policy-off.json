{
  "scenario": "waiting-approval-policy-off",
  "about": "Waiting does not change which calls the approval policy allows or refuses.",
  "rules": ["contracts.md#approvals-that-wait","bindings/data.md#waiting-approval-records","sdk/api.md#questions"],
  "requires": {"approvalsOutlastTurns":true},
  "agent": {"durability":"kept","plugins":["counter"],"approval":"off","maxApprovalWaitMs":100,"settings":{"approvalWait":"untilDeadline"}},
  "model": [
    {"toolCalls":[{"name":"bump","input":{"hold":false}}]},
    {"text":"Done."}
  ],
  "steps": [
    {"prompt":"Call the tool.","expect":{"outcome":"completed","openToolCalls":[],"toolResults":[{"name":"bump","status":"completed"}],"recordCounts":{"inputRequest":0,"toolPending":0,"toolStarted":1},"count":1}}
  ]
}
